# ==========================================
# PROSPACE ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public API Configuration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Environment
VITE_APP_NAME=ProSpace
VITE_APP_URL=http://localhost:3000

# Backend / Edge Function Secrets (NEVER prefix with VITE_)
# Used in edge functions or backend deployments
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
VERCEL_CLIENT_ID=your-vercel-client-id
VERCEL_CLIENT_SECRET=your-vercel-client-secret
VERCEL_WEBHOOK_SECRET=your-vercel-webhook-secret
